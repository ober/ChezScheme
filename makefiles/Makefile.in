# The `configure` script adjusts the next line:
workarea=$(w)

include $(workarea)/Mf-config

.PHONY: build
build: $(ZUO_DEP)
	+ $(ZUO) $(workarea) MAKE="$(MAKE)"

.PHONY: run
run: $(ZUO_DEP)
	+ $(ZUO) $(workarea) run

.PHONY: kernel
kernel: $(ZUO_DEP)
	+ $(ZUO) $(workarea) kernel MAKE="$(MAKE)"

.PHONY: install
install: $(ZUO_DEP)
	$(ZUO) $(workarea) install MAKE="$(MAKE)" DESTDIR="$(DESTDIR)"

.PHONY: uninstall
uninstall: $(ZUO_DEP)
	+ $(ZUO) $(workarea) uninstall MAKE="$(MAKE)"

.PHONY: test-one
test-one: $(ZUO_DEP)
	+ $(ZUO) $(workarea) test-one MAKE="$(MAKE)"

.PHONY: test-one-safe
test-one-safe: $(ZUO_DEP)
	+ $(ZUO) $(workarea) test-one-safe MAKE="$(MAKE)"

.PHONY: test-some-fast
test-some-fast: $(ZUO_DEP)
	+ $(ZUO) $(workarea) test-some-fast MAKE="$(MAKE)"

.PHONY: test-some
test-some: $(ZUO_DEP)
	+ $(ZUO) $(workarea) test-some MAKE="$(MAKE)"

.PHONY: test
test: $(ZUO_DEP)
	+ $(ZUO) $(workarea) test MAKE="$(MAKE)"

.PHONY: test-more
test-more: $(ZUO_DEP)
	+ $(ZUO) $(workarea) test-more MAKE="$(MAKE)"

.PHONY: coverage
coverage: $(ZUO_DEP)
	+ $(ZUO) $(workarea) coverage MAKE="$(MAKE)"

.PHONY: bootfiles
bootfiles: $(ZUO_DEP)
	+ $(ZUO) $(workarea) bootfiles MAKE="$(MAKE)"

.PHONY: reset
reset: $(ZUO_DEP)
	+ $(ZUO) $(workarea) reset MAKE="$(MAKE)"

# Supply XM=<machine> to build boot files for <machine>
.PHONY: boot
boot:
	+ $(ZUO) $(workarea) boot "$(XM)" MAKE="$(MAKE)"

# `<machine>.boot` as alias for `boot XM=<machine>`
%.boot: $(ZUO_DEP)
	+ $(ZUO) $(workarea) boot $* MAKE="$(MAKE)"

.PHONY: auto.boot
auto.boot: $(ZUO_DEP)
	+ $(ZUO) $(workarea) boot MAKE="$(MAKE)"

SCHEME=scheme

.PHONY: cross.boot
cross.boot: $(ZUO_DEP)
	+ $(ZUO) $(workarea) boot SCHEME="$(SCHEME)" MAKE="$(MAKE)"

.PHONY: re.boot
re.boot: $(ZUO_DEP)
	+ $(ZUO) $(workarea) reboot SCHEME="$(SCHEME)"

# Supply XM=<machine> to build boot files for <machine>
# with o=3 d=0 for the cross compiler, and only after
# building the kernel for the configured machine
.PHONY: bootquick
bootquick: $(ZUO_DEP)
	+ $(ZUO) $(workarea) bootquick "$(XM)" MAKE="$(MAKE)"

# `<machine>.bootquick` as alias for `boot XM=<machine>`
%.bootquick: $(ZUO_DEP)
	+ $(ZUO) $(workarea) bootquick $* MAKE="$(MAKE)"

auto.bootquick: $(ZUO_DEP)
	+ $(ZUO) $(workarea) bootquick MAKE="$(MAKE)"

# Supply XM=<machine>-<tag>.bootpbchunk to repackage boot files for
# <machine> with pbchunk sources, including additional
# boot files
.PHONY: bootpbchunk
bootpbchunk: $(ZUO_DEP)
	+ $(ZUO) $(workarea) bootpbchunk "$(XM)" $(ARGS) MAKE="$(MAKE)"

# `<machine>.bootpbchunk` as alias for `pbchunk XM=<machine>`
%.bootpbchunk: $(ZUO_DEP)
	+ $(ZUO) $(workarea) bootpbchunk $* $(ARGS) MAKE="$(MAKE)"

# Supply XM=<machine> to compile for <machine> with configure
# arguments in ARGS
cross: $(ZUO_DEP)
	+ $(ZUO) $(workarea) MAKE="$(MAKE)" -- cross "$(XM)" $(ARGS)

# `<machine>.cross` as alias for `cross XM=<machine>`
%.cross: $(ZUO_DEP)
	+ $(ZUO) $(workarea) MAKE="$(MAKE)" -- cross $* $(ARGS)

# Supply XM=<machine> to install cross-compiled for <machine>
cross-install: $(ZUO_DEP)
	+ $(ZUO) $(workarea) MAKE="$(MAKE)"  DESTDIR="$(DESTDIR)" -- cross-install "$(XM)"

# `<machine>.install` as alias for `cross-install XM=<machine>`
%.install: $(ZUO_DEP)
	+ $(ZUO) $(workarea) MAKE="$(MAKE)"  DESTDIR="$(DESTDIR)" -- cross-install $*

.PHONY: docs
docs: build $(ZUO_DEP)
	+ $(ZUO) $(workarea) docs MAKE="$(MAKE)"

.PHONY: csug
csug: build $(ZUO_DEP)
	+ $(ZUO) $(workarea) csug MAKE="$(MAKE)"

.PHONY: release_notes
release_notes: build $(ZUO_DEP)
	+ $(ZUO) $(workarea) release_notes MAKE="$(MAKE)"

.PHONY: install-docs
install-docs: build $(ZUO_DEP)
	+ $(ZUO) $(workarea) install-docs MAKE="$(MAKE)"

.PHONY: install-csug
install-csug: build $(ZUO_DEP)
	+ $(ZUO) $(workarea) install-csug MAKE="$(MAKE)"

.PHONY: install-release_notes
install-release_notes: build $(ZUO_DEP)
	+ $(ZUO) $(workarea) install-release_notes MAKE="$(MAKE)"

.PHONY: bintar
bintar: $(ZUO_DEP)
	+ $(ZUO) $(workarea) bintar MAKE="$(MAKE)"

.PHONY: rpm
rpm: $(ZUO_DEP)
	+ $(ZUO) $(workarea) rpm MAKE="$(MAKE)"

.PHONY: pkg
pkg: $(ZUO_DEP)
	+ $(ZUO) $(workarea) pkg MAKE="$(MAKE)"

.PHONY: clean
clean: $(ZUO_DEP)
	+ $(ZUO) $(workarea) clean MAKE="$(MAKE)"
	$(RM_ZUO)

# Using `+` here means that $(ZUO) gets built even if `-n`/`--dry-run` is provided to `make`
$(ZUO_TARGET): $(srcdir)/zuo/zuo.c
	+ mkdir -p bin
	+ $(CC_FOR_BUILD) $(CFLAGS_FOR_BUILD) -DZUO_LIB_PATH='"'"$(upsrcdir)/zuo/lib"'"' -o $(ZUO) $(srcdir)/zuo/zuo.c

# ── Sync from upstream Cisco ChezScheme ──────────────────────────────────────
# Our fork (github.com/ober/ChezScheme) carries local commits on top of
# upstream/main (Round 12+ phases, jerboa-perf, secure, etc.). These targets
# add an `upstream` remote pointing at cisco/ChezScheme and rebase our main
# onto it so we pull in upstream bug fixes without losing local work.
#
# Use:
#   make sync-upstream-status    — show ahead/behind, list new upstream commits
#   make sync-upstream           — fetch upstream + rebase HEAD onto upstream/main
#
# After a successful rebase you'll need `git push --force-with-lease origin main`
# to update your fork. Don't do that until you've also rebuilt and tested.

UPSTREAM_URL := https://github.com/cisco/ChezScheme.git

.PHONY: upstream-remote
upstream-remote:
	@if ! git remote get-url upstream >/dev/null 2>&1; then \
	  echo "==> Adding upstream remote: $(UPSTREAM_URL)"; \
	  git remote add upstream $(UPSTREAM_URL); \
	else \
	  current=$$(git remote get-url upstream); \
	  if [ "$$current" != "$(UPSTREAM_URL)" ]; then \
	    echo "==> upstream points to $$current (expected $(UPSTREAM_URL))"; \
	    echo "    Run: git remote set-url upstream $(UPSTREAM_URL)"; \
	    exit 1; \
	  fi; \
	fi

.PHONY: sync-upstream-status
sync-upstream-status: upstream-remote
	@git fetch upstream --quiet
	@branch=$$(git rev-parse --abbrev-ref HEAD); \
	ahead=$$(git rev-list --count upstream/main..HEAD); \
	behind=$$(git rev-list --count HEAD..upstream/main); \
	echo "Branch: $$branch"; \
	echo "Ahead of upstream/main:  $$ahead commits"; \
	echo "Behind upstream/main:    $$behind commits"; \
	echo ""; \
	if [ "$$behind" = "0" ]; then \
	  echo "Already up to date with upstream/main."; \
	else \
	  echo "Upstream commits not yet in $$branch (most recent first):"; \
	  git log --oneline HEAD..upstream/main | head -30; \
	fi

.PHONY: sync-upstream
sync-upstream: upstream-remote
	@if ! git diff-index --quiet HEAD --; then \
	  echo "==> Working tree has uncommitted changes — commit or stash first"; \
	  git status --short; \
	  exit 1; \
	fi
	@if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ]; then \
	  echo "==> A rebase is already in progress — finish or abort it first:"; \
	  echo "    git rebase --continue   (after fixing conflicts)"; \
	  echo "    git rebase --abort      (give up and restore HEAD)"; \
	  exit 1; \
	fi
	@echo "==> Fetching upstream ($(UPSTREAM_URL))..."
	@git fetch upstream
	@branch=$$(git rev-parse --abbrev-ref HEAD); \
	ahead=$$(git rev-list --count upstream/main..HEAD); \
	behind=$$(git rev-list --count HEAD..upstream/main); \
	echo "==> $$branch is $$ahead ahead, $$behind behind upstream/main"; \
	if [ "$$behind" = "0" ]; then \
	  echo "==> Already up to date — nothing to rebase."; \
	  exit 0; \
	fi; \
	echo "==> Rebasing $$branch onto upstream/main..."; \
	if ! git rebase upstream/main; then \
	  echo ""; \
	  echo "==> Rebase hit a conflict. Resolve files listed by 'git status',"; \
	  echo "    then 'git add <file>' and 'git rebase --continue'."; \
	  echo "    Or 'git rebase --abort' to bail out."; \
	  exit 1; \
	fi
	@echo "==> Rebase complete. Next steps:"
	@echo "    1. make clean && ./configure --installprefix=/opt/homebrew && make && make install"
	@echo "    2. Verify: scheme --version  and  rebuild jerboa-shell"
	@echo "    3. git push --force-with-lease origin $$(git rev-parse --abbrev-ref HEAD)"
